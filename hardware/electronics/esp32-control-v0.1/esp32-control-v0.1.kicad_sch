	(text "PINGPANG SMARTGEAR / ESP32-S3 CONTROL + 1S POWER"
		(exclude_from_sim no)
		(at 12 14 0)
		(effects (font (size 2 2)) (justify left bottom))
		(uuid "d9f73715-9da8-4f77-af5e-60707fd88858")
	)
	(text "The y+ UI-panel Type-C is the sole external charge input; J7 pins 13/14 carry VBUS/GND to the mother-board PTC"
		(exclude_from_sim no)
		(at 12 22 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "17803dae-1524-459f-8075-d8b4548756d3")
	)
	(text "BT1 is a protected 1S pouch in the left emitter-side clamp; J_BAT is serviceable"
		(exclude_from_sim no)
		(at 12 28 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "8110f3fa-772b-409e-9884-3f6ba78df588")
	)
	(text "U2 IP5305 power path -> SYS_5V; U3 TPS62162 -> regulated +3V3 for ESP32 and sensors"
		(exclude_from_sim no)
		(at 12 34 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "62f4a04f-cfa6-4cbc-8c0d-128183b8397f")
	)
	(text "J4: MX1.25 keyed harness to M6 carrier; J7: 14-pin keyed UI daughter cable with VBUS/GND"
		(exclude_from_sim no)
		(at 116 28 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "27dba9bc-c28a-4a6c-b197-863598054774")
	)
	(text "J5: PVDF / auxiliary ADC; every field wire leaves through a lockable connector"
		(exclude_from_sim no)
		(at 116 34 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "f459a597-d595-44dc-9d47-715bee6bc4a4")
	)
	(text "J3/J8 sensor return is 0V_SENSOR and stays separate from MCU GND until the isolation/power design is approved"

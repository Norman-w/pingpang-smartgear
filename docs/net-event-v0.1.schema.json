    },
    "beam_mask": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1023
    },
    "beam_height_mm": {
      "type": "array",
      "enum": [
        [0, 0],
        [10, 10], [10, 20], [10, 30], [10, 40], [10, 50],
        [10, 60], [10, 70], [10, 80], [10, 90], [10, 100],
        [20, 20], [20, 30], [20, 40], [20, 50], [20, 60],
        [20, 70], [20, 80], [20, 90], [20, 100],
        [30, 30], [30, 40], [30, 50], [30, 60], [30, 70],
        [30, 80], [30, 90], [30, 100],
        [40, 40], [40, 50], [40, 60], [40, 70], [40, 80],
        [40, 90], [40, 100],
        [50, 50], [50, 60], [50, 70], [50, 80], [50, 90], [50, 100],
        [60, 60], [60, 70], [60, 80], [60, 90], [60, 100],
        [70, 70], [70, 80], [70, 90], [70, 100],
        [80, 80], [80, 90], [80, 100],
        [90, 90], [90, 100],
        [100, 100]
      ]
    },
    "ball_bottom_gap_mm": {
      "type": "array",
      "enum": [

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Norman-w/pingpang-smartgear/schema/field-validation-record-v0.1.json",
  "title": "Pingpang SmartGear field validation record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "firmware_commit",
    "cad_commit",
    "calibration_id",
    "evidence_root",
    "results"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "firmware_commit": {"type": "string", "minLength": 1},
    "cad_commit": {"type": "string", "minLength": 1},
    "board_version": {"type": "string"},
    "net_model": {"type": "string"},
    "calibration_id": {"type": "string", "minLength": 1},
    "evidence_root": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "M-01", "M-02", "M-03",
        "B-01", "B-02", "B-03", "B-04", "B-05", "B-06", "B-07", "B-08", "B-09",
        "S-01", "S-02", "S-03",
        "T-01", "T-02", "T-03",
        "E-01"
      ],
      "patternProperties": {
        "^(M|B|S|T|E)-[0-9]{2}$": {"$ref": "#/$defs/result"}
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "pass", "fail", "not_applicable"]
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      }
    }
  }
}
